# TaskFlow – Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Real passwords are stored in .secrets/ as Docker Secrets.
#       This file does NOT contain any credentials.
#       See README.md for setup instructions.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
# POSTGRES_PASSWORD is injected via Docker Secret (.secrets/db_password)

# Grafana
# GF_SECURITY_ADMIN_USER is set in docker-compose.yml
# GF_SECURITY_ADMIN_PASSWORD is injected via Docker Secret (.secrets/grafana_password)